# Caddy obtient et renouvelle seul le certificat HTTPS (Let's Encrypt) pour {$DOMAIN}.
{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# Grafana : uniquement depuis les adresses autorisées (VPN WireGuard, bureau…).
	# L'espace admin reste ouvert à Internet (choix de l'exploitant) : mot de passe + code TOTP + blocage.
	# Le refus est dans un « handle » placé en premier : un « respond » seul passerait APRÈS les
	# blocs handle (ordre imposé par Caddy) et ne serait jamais atteint.
	@prive {
		path /grafana*
		not remote_ip {$ADMIN_ALLOWED_IPS}
	}
	handle @prive {
		respond "Accès refusé" 403
	}

	handle /grafana* {
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy app:80
	}
}

# Raccourci pour les postes de l'équipe : connection.gi est déclaré dans leur fichier hosts
# (51.21.209.22 connection.gi). Ce n'est pas un vrai domaine, il n'a donc pas de certificat :
# il répond en HTTP et renvoie aussitôt vers l'adresse officielle en HTTPS.
http://connection.gi {
	redir https://{$DOMAIN}{uri} 302
}
