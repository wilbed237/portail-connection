# Copier en .env sur le serveur, remplir, puis : chmod 600 .env
# Ce fichier .env ne doit JAMAIS être publié (il est ignoré par Git).

# ---- Domaine et accès
DOMAIN=paiement.exemple.cm
APP_URL=https://paiement.exemple.cm
# Origine du portail captif autorisée à appeler l'API (adresse du hotspot, ou * )
ALLOWED_ORIGIN=*
# Adresses autorisées pour /admin et /grafana : réseau WireGuard + IP fixe du bureau, séparées par des espaces
ADMIN_ALLOWED_IPS=10.66.66.0/24

# ---- Base de données (mots de passe longs et aléatoires : openssl rand -base64 24)
DB_DSN=pgsql:host=db;dbname=gandal
DB_USER=gandal
DB_PASSWORD=
GRAFANA_DB_PASSWORD=

# ---- API de paiement IZI Spot (noms imposés par la documentation IZI Spot)
# Les deux clés du même marchand sont envoyées à chaque appel.
PAYMENT_PUBLISHABLE_KEY=
PAYMENT_SECRET_KEY=
# Secret partagé qui sert uniquement à vérifier la signature (xkey) des webhooks
WEBHOOK_SIGNING_SECRET=
PAYMENT_API_BASE=https://payment-api.izispot.co

# ---- Routeur MikroTik, par le tunnel WireGuard (valeurs données par bin/mikrotik-setup.php)
ROUTER_URL=https://10.66.66.2:8443
ROUTER_USER=gandal-api
ROUTER_PASSWORD=
# Empreinte de la clé publique du certificat du routeur (voir README) : sha256//xxxxxxxx=
ROUTER_TLS_PIN=
ROUTER_TIMEOUT=8

# ---- Alertes Telegram (facultatif) : créer un bot avec @BotFather, puis récupérer l'identifiant du groupe
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STOCK_MIN=5
DAILY_REPORT_HOUR=21

# ---- Grafana
GRAFANA_ADMIN_USER=gandal
GRAFANA_ADMIN_PASSWORD=
GRAFANA_URL=/grafana/
