  {
   "id": 8,
   "title": "Consommation par heure de la journée",
   "type": "barchart",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "gandal-pg"
   },
   "gridPos": {
    "x": 12,
