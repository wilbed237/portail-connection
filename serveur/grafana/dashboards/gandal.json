   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gandal-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT COALESCE(sum(amount),0) AS \"Chiffre d'affaires\" FROM v_ventes WHERE status IN ('paid','complete','paid_no_ticket') AND $__timeFilter(paid_at)"
    }
   ],
   "fieldConfig": {
