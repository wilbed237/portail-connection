    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gandal-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT lpad(extract(hour FROM ts AT TIME ZONE 'Africa/Douala')::int::text, 2, '0') || ' h' AS \"Heure\", sum(bytes_total) AS \"Consommé\" FROM v_conso WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
