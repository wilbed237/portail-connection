  {
   "id": 5,
   "title": "Chiffre d'affaires par période",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "gandal-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gandal-pg"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT date_trunc('$granularite', paid_at, 'Africa/Douala') AS time, sum(amount) AS \"Chiffre d'affaires\", sum(net) AS \"Net estimé\" FROM v_ventes WHERE status IN ('paid','complete','paid_no_ticket') AND $__timeFilter(paid_at) GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
